# Resend transactional email (https://resend.com)
RESEND_API_KEY=

# Browserless.io headless Chrome (https://www.browserless.io/)
BROWSERLESS_API_KEY=

# Shared secret for the public /api/v1/scan endpoint
CICD_API_KEY=

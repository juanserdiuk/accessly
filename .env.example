# Public app URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin email — granted admin access in the app (server-only, not exposed to client)
ADMIN_EMAIL=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend transactional email (https://resend.com)
RESEND_API_KEY=

# Optional. Branded From address for transactional emails. The domain
# must be verified in Resend first. If unset, emails are sent from
# "Accessly <onboarding@resend.dev>".
# EMAIL_FROM=Accessly <noreply@accessly.us>

# Browserless.io headless Chrome (https://www.browserless.io/)
BROWSERLESS_API_KEY=

# Shared secret for the public /api/v1/scan endpoint
CICD_API_KEY=

# Optional. Secret for the Vercel-cron-driven scheduled scans worker.
# If unset, falls back to CICD_API_KEY.
# CRON_SECRET=

# Optional. URL of the founder explainer video shown on the landing.
# Drop an MP4 in /public or host elsewhere; leave unset to show a placeholder.
# NEXT_PUBLIC_EXPERT_VIDEO_URL=/accessly-explainer.mp4
# NEXT_PUBLIC_EXPERT_VIDEO_POSTER=/accessly-explainer-poster.jpg

# Optional. Founder ops channel for BUSINESS events (signups, paid
# subscriptions, pack purchases, cancellations, contact form
# submissions, scan regressions). Slack incoming webhook URL works
# directly; Discord webhook URLs work if you append `/slack` to the URL.
# When unset, all notify() calls are no-ops. See lib/notify.ts.
# OPS_WEBHOOK_URL=
